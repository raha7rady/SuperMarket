@using Microsoft.AspNetCore.Identity
@using SuperMarket.Infrastructure.Identity

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var isSignedIn = User.Identity?.IsAuthenticated == true;

    string IsActive(string ctrl, string ar = "")
        => (controller == ctrl && (string.IsNullOrEmpty(ar) || area == ar))
            ? "active"
            : "";

    var cartCount = ViewBag.CartCount as int? ?? 0;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content="سوپرمارکت آنلاین - خرید سریع و مطمئن" />
    <meta name="theme-color" content="#198754" />

    <title>@ViewData["Title"] | SuperMarket</title>

    <!-- Fonts -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- ================= HEADER ================= -->
    <header class="store-header">

        <nav class="navbar navbar-expand-lg">

            <div class="container">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-basket2-fill me-2"></i>
                    سوپرمارکت
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- MENU -->
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link @IsActive("Home")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                خانه
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @IsActive("Product","Customer")"
                               asp-area="Customer"
                               asp-controller="Product"
                               asp-action="Index">
                                محصولات
                            </a>
                        </li>

                    </ul>

                    <!-- SEARCH -->
                    <form class="store-search mx-lg-4 my-3 my-lg-0"
                          asp-area="Customer"
                          asp-controller="Product"
                          asp-action="Index"
                          method="get">

                        <div class="input-group">

                            <input type="search"
                                   name="SearchTerm"
                                   value="@Context.Request.Query["SearchTerm"]"
                                   class="form-control"
                                   placeholder="جستجو..."
                                   autocomplete="off" />

                            <button class="btn btn-primary">
                                <i class="bi bi-search"></i>
                            </button>

                        </div>

                    </form>

                    <!-- RIGHT MENU -->
                    <ul class="navbar-nav align-items-center gap-2">

                        <!-- CART -->
                        <li class="nav-item">
                            <a class="nav-link cart-icon position-relative"
                               asp-area="Customer"
                               asp-controller="Cart"
                               asp-action="Index">

                                <i class="bi bi-cart3 fs-5"></i>

                                @if (cartCount > 0)
                                {
                                    <span class="cart-badge">@cartCount</span>
                                }

                            </a>
                        </li>

                        @if (isSignedIn)
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                   data-bs-toggle="dropdown">

                                    <i class="bi bi-person-circle me-1"></i>
                                    @(User.Identity?.Name ?? "کاربر")

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                                    @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                    {
                                        <li>
                                            <a class="dropdown-item"
                                               asp-area="Admin"
                                               asp-controller="Dashboard"
                                               asp-action="Index">
                                                پنل مدیریت
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }

                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Customer"
                                           asp-controller="Order"
                                           asp-action="Index">
                                            سفارش‌های من
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <form asp-area=""
                                              asp-controller="Account"
                                              asp-action="Logout"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <button class="dropdown-item text-danger">
                                                خروج
                                            </button>
                                        </form>
                                    </li>

                                </ul>

                            </li>
                        }
                        else
                        {
                            <li>
                                <a class="btn btn-outline-primary"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Login">
                                    ورود
                                </a>
                            </li>

                            <li>
                                <a class="btn btn-primary"
                                   asp-area=""
                                   asp-controller="Account"
                                   asp-action="Register">
                                    ثبت نام
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <!-- ================= MAIN ================= -->
    <main class="store-main">

        <!-- Toast Container (ONLY ONE SYSTEM) -->
        <div id="toast-container"
             class="toast-container position-fixed top-0 start-0 p-3"
             style="z-index: 99999">
        </div>

        <div class="container py-4">
            @RenderBody()
        </div>

    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="store-footer text-center small py-3">
        © @DateTime.UtcNow.Year SuperMarket
    </footer>

    <!-- ================= SCRIPTS ================= -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Core JS (IMPORTANT ORDER) -->
    <script src="~/js/core/app.js" asp-append-version="true"></script>
    <script src="~/js/core/toast.js" asp-append-version="true"></script>
    <script src="~/js/core/utils.js" asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/shop.js" asp-append-version="true"></script>
    <script src="~/js/product.js" asp-append-version="true"></script>
    <script src="~/js/cart.js" asp-append-version="true"></script>


    <!-- ================= TEMP DATA TOAST BRIDGE ================= -->
    
    <script>
               App.ready(function () {
            
                          const success = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]));
                       const error = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]));
            
                            if (success) {
                                   Toast.success(success);
                               }
            
                           if (error) {
                                   Toast.error(error);
                                }
            
                        });
        </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>