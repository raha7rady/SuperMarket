@using Microsoft.AspNetCore.Identity
@using SuperMarket.Infrastructure.Identity

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isSignedIn = User.Identity?.IsAuthenticated == true;

    string IsActive(string ctrl, string act = "Index")
        => (controller == ctrl && action == act)
            ? "active fw-bold text-success"
            : "";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>
        @(ViewData["Title"] != null
            ? $"{ViewData["Title"]} | سوپرمارکت آنلاین"
            : "سوپرمارکت آنلاین")
    </title>

    <meta name="description" content="سوپرمارکت آنلاین - خرید سریع و مطمئن" />
    <meta name="keywords" content="سوپرمارکت, خرید آنلاین, فروشگاه اینترنتی" />
    <meta name="author" content="SuperMarket" />

    <!-- Fonts & Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- App CSS -->
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body class="d-flex flex-column min-vh-100">

    <!-- ================= TOAST SYSTEM ================= -->
    <div id="toast-container"
         class="toast-container position-fixed top-0 start-0 p-3"></div>

    <header class="border-bottom bg-white shadow-sm">

        <nav class="navbar navbar-expand-lg container">

            <a class="navbar-brand fw-bold text-success"
               asp-area=""
               asp-controller="Home"
               asp-action="Index"
               title="بازگشت به صفحه اصلی">
                

                <i class="bi bi-basket2-fill ms-1"></i>
                سوپرمارکت آنلاین
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link @IsActive("Home")"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Index">
                            خانه
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link @IsActive("Product")"
                           asp-area="Customer"
                           asp-controller="Product"
                           asp-action="Index">
                            محصولات
                        </a>
                    </li>

                </ul>

                <!-- SEARCH -->
                <form class="d-flex mx-lg-3 my-3 my-lg-0"
                      asp-area="Customer"
                      asp-controller="Product"
                      asp-action="Index"
                      method="get">

                    <input type="search"
                           name="SearchTerm"
                           value="@Context.Request.Query["SearchTerm"]"
                           class="form-control"
                           placeholder="جستجو..." />

                    <button class="btn btn-success ms-2">
                        <i class="bi bi-search"></i>
                    </button>

                </form>

                <!-- RIGHT MENU -->
                <ul class="navbar-nav align-items-center gap-2">

                    <li class="nav-item">
                        <a class="nav-link position-relative"
                           asp-area="Customer"
                           asp-controller="Cart"
                           asp-action="Index">

                            <i class="bi bi-cart3 fs-5"></i>
                        </a>
                    </li>

                    @if (isSignedIn)
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-person-circle ms-1"></i>
                                @(User.Identity?.Name ?? "کاربر")

                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                                @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                                {
                                    <li>
                                        <a class="dropdown-item"
                                           asp-area="Admin"
                                           asp-controller="Dashboard"
                                           asp-action="Index">
                                            پنل مدیریت
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>
                                }

                                <li>
                                    <form asp-area=""
                                          asp-controller="Account"
                                          asp-action="Logout"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button class="dropdown-item text-danger">
                                            خروج
                                        </button>

                                    </form>
                                </li>

                            </ul>

                        </li>
                    }
                    else
                    {
                        <li>
                            <a class="btn btn-outline-success"
                               asp-area=""
                               asp-controller="Account"
                               asp-action="Login">
                                ورود
                            </a>
                        </li>

                        <li>
                            <a class="btn btn-success"
                               asp-area=""
                               asp-controller="Account"
                               asp-action="Register">
                                ثبت نام
                            </a>
                        </li>
                    }

                </ul>

            </div>

        </nav>

    </header>

    <!-- ================= MAIN ================= -->
    <main class="flex-grow-1">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <!-- ================= FOOTER ================= -->
    <footer class="bg-dark text-light py-4 mt-auto">
        <div class="container text-center">
            <small>© @DateTime.UtcNow.Year SuperMarket</small>
        </div>
    </footer>

    <!-- ================= SCRIPTS ================= -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/core/app.js" asp-append-version="true"></script>
    <script src="~/js/core/toast.js" asp-append-version="true"></script>
    <script src="~/js/core/utils.js" asp-append-version="true"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <partial name="_ValidationScriptsPartial" />

    <!-- ================= TEMP DATA TOAST BRIDGE ================= -->
    <script>
        App.ready(function () {

            const success = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]));
            const error = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]));

            if (success) {
                Toast.success(success);
            }

            if (error) {
                Toast.error(error);
            }

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>