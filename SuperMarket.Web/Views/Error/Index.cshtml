@model SuperMarket.Web.ViewModels.ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5 text-center">
    <h1 class="display-4 text-danger">Oops! Something went wrong.</h1>
    <p class="lead">@Model.ErrorMessage</p>

    @if (!string.IsNullOrEmpty(Model.Path))
    {
        <p><strong>Path:</strong> @Model.Path</p>
    }

    @if (Model.ShowRequestId)
    {
        <p><strong>Request ID:</strong> @Model.RequestId</p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        Back to Home
    </a>
</div>