@{
    ViewData["Title"] = "عدم دسترسی";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 col-sm-10">

                <div class="card auth-card">
                    <div class="auth-card-body auth-static-page">

                        <div class="auth-icon-badge is-danger">
                            <i class="bi bi-shield-exclamation" aria-hidden="true"></i>
                        </div>

                        <h1>دسترسی غیرمجاز</h1>
                        <p>
                            شما اجازه دسترسی به این صفحه را ندارید. اگر فکر می‌کنید این یک اشتباه است،
                            با پشتیبانی تماس بگیرید یا با حساب کاربری دیگری وارد شوید.
                        </p>

                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a class="btn btn-primary btn-submit" asp-controller="Home" asp-action="Index">
                                بازگشت به صفحه اصلی
                            </a>

                            @if (!string.IsNullOrWhiteSpace(returnUrl))
                            {
                                <a class="btn btn-outline-primary btn-submit"
                                   asp-controller="Account"
                                   asp-action="Login"
                                   asp-route-returnUrl="@returnUrl">
                                    ورود با حساب دیگر
                                </a>
                            }
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
