@model SuperMarket.Web.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "تغییر رمز عبور";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7 col-sm-10">

                <div class="card auth-card">
                    <div class="auth-card-body">

                        <div class="auth-header">
                            <div class="auth-icon-badge">
                                <i class="bi bi-shield-lock" aria-hidden="true"></i>
                            </div>
                            <h1>تغییر رمز عبور</h1>
                            <p>برای تغییر رمز عبور، ابتدا رمز فعلی خود را وارد کنید</p>
                        </div>

                        <div asp-validation-summary="All"
                             class="alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : "")"
                             role="alert">
                        </div>

                        <form asp-action="ChangePassword" method="post" novalidate>

                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="CurrentPassword" class="form-label">رمز عبور فعلی</label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock" aria-hidden="true"></i>
                                    </span>

                                    <input asp-for="CurrentPassword"
                                           id="currentPassword"
                                           type="password"
                                           class="form-control"
                                           placeholder="رمز عبور فعلی"
                                           autocomplete="current-password" />

                                    <button type="button"
                                            class="btn password-toggle-btn"
                                            data-toggle-password="currentPassword"
                                            aria-pressed="false"
                                            aria-label="نمایش رمز عبور">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label">رمز عبور جدید</label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-key" aria-hidden="true"></i>
                                    </span>

                                    <input asp-for="NewPassword"
                                           id="newPassword"
                                           type="password"
                                           class="form-control"
                                           placeholder="رمز عبور جدید"
                                           autocomplete="new-password"
                                           data-password-strength
                                           data-strength-bar="strengthBar"
                                           data-strength-text="strengthText" />

                                    <button type="button"
                                            class="btn password-toggle-btn"
                                            data-toggle-password="newPassword"
                                            aria-pressed="false"
                                            aria-label="نمایش رمز عبور">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>

                                <div class="strength-meter">
                                    <div class="progress">
                                        <div id="strengthBar"
                                             class="progress-bar"
                                             role="progressbar"
                                             aria-valuemin="0"
                                             aria-valuemax="100"
                                             aria-valuenow="0"
                                             aria-label="میزان قدرت رمز عبور"></div>
                                    </div>
                                    <small id="strengthText"></small>
                                </div>

                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label">تکرار رمز عبور جدید</label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                                    </span>

                                    <input asp-for="ConfirmPassword"
                                           id="confirmPassword"
                                           type="password"
                                           class="form-control"
                                           placeholder="تکرار رمز عبور جدید"
                                           autocomplete="new-password" />

                                    <button type="button"
                                            class="btn password-toggle-btn"
                                            data-toggle-password="confirmPassword"
                                            aria-pressed="false"
                                            aria-label="نمایش رمز عبور">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </button>
                                </div>

                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-submit">
                                تغییر رمز عبور
                            </button>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/account.js" asp-append-version="true"></script>
}
