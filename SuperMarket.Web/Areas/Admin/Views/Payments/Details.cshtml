@model SuperMarket.Application.DTOs.Payments.PaymentAdminDto

@{
    ViewData["Title"] = "Payment Details";
}

<h2 class="mb-4">Payment Details</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Order</dt>
            <dd class="col-sm-9">
                <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">@Model.OrderId</a>
            </dd>

            <dt class="col-sm-3">Amount</dt>
            <dd class="col-sm-9">@Model.Amount.ToString("N0")</dd>

            <dt class="col-sm-3">Method</dt>
            <dd class="col-sm-9">@Model.PaymentMethod</dd>

            <dt class="col-sm-3">Transaction Id</dt>
            <dd class="col-sm-9">@Model.TransactionId</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Status</span></dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Created</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="d-flex gap-2 flex-wrap">
    <form asp-action="MarkAsProcessing" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary">Mark as Processing</button>
    </form>

    <form asp-action="MarkAsPaid" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success">Mark as Paid</button>
    </form>

    <form asp-action="MarkAsFailed" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Mark as Failed</button>
    </form>

    <form asp-action="MarkAsRefunded" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-info">Mark as Refunded</button>
    </form>

    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger">Cancel</button>
    </form>
</div>

<a asp-action="Index" class="btn btn-link mt-3">Back to list</a>
