@using SuperMarket.Web.Areas.Admin.ViewModels.Categories
@model CategoryFormViewModel

<form method="post" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model is CategoryEditViewModel editModel)
    {
        <input type="hidden" name="Id" value="@editModel.Id" />
        @if (editModel.RowVersion != null)
        {
            <input type="hidden" name="RowVersion"
                   value="@Convert.ToBase64String(editModel.RowVersion)" />
        }
    }

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title"
               class="form-control"
               value="@Model.TrimmedTitle" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" class="form-control" />
        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
    </div>

    @if (Model is CategoryEditViewModel editVm)
    {
        <div class="form-check mb-3">
            <input type="checkbox"
                   name="IsActive"
                   class="form-check-input"
                   value="true"
            @(editVm.IsActive ? "checked" : "") />
            <label class="form-check-label">Active</label>
        </div>
    }

    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="Categories"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

        <button type="submit"
                class="btn btn-success">
            Save
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}