@using SuperMarket.Web.Areas.Admin.ViewModels.Categories

@model SuperMarket.Web.Areas.Admin.ViewModels.Categories.CategoryListItemViewModel

<tr>
    <td>@Model.Title</td>
    <td>@Model.DisplayOrder</td>
    <td>@Model.ProductCount</td>
    <td>
        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
            @Model.StatusLabel
        </span>
    </td>
    <td>@Model.CreatedAt.ToString("yyyy-MM-dd")</td>
    <td>@(Model.UpdatedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
    <td class="text-end">
        <a asp-controller="Categories"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-sm btn-warning">
            Edit
        </a>

        <form asp-controller="Categories"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post"
              class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this category?');">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="btn btn-sm btn-danger">
                Delete
            </button>
        </form>
    </td>
</tr>