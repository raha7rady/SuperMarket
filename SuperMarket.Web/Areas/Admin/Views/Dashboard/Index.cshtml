@model SuperMarket.Web.Areas.Admin.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h1 class="mb-4">Admin Dashboard</h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">
        @await Html.PartialAsync("_DashboardStatisticsPartial", Model.Statistics)
        @await Html.PartialAsync("_DashboardSalesPartial", Model.Sales)
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            @await Html.PartialAsync("_RecentOrdersPartial", Model.RecentOrders)
        </div>
        <div class="col-md-6">
            @await Html.PartialAsync("_RecentUsersPartial", Model.RecentUsers)
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            @await Html.PartialAsync("_LowStockProductsPartial", Model.LowStockProducts)
        </div>
    </div>
</div>