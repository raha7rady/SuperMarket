@using SuperMarket.Web.Areas.Admin.ViewModels.Orders

@model SuperMarket.Web.Areas.Admin.ViewModels.Orders.OrderListViewModel
@{
    ViewData["Title"] = "Orders";
}

<h2 class="mb-4">Orders</h2>

<!-- Filter -->
<form method="get" class="card card-body mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <input asp-for="Filter.UserName" class="form-control" placeholder="User name" />
        </div>
        <div class="col-md-3">
            <select asp-for="Filter.OrderStatus" class="form-select"
                    asp-items="Html.GetEnumSelectList<OrderStatusViewModel>()">
                <option value="">All Order Status</option>
            </select>
        </div>
        <div class="col-md-3">
            <select asp-for="Filter.PaymentStatus" class="form-select"
                    asp-items="Html.GetEnumSelectList<PaymentStatusViewModel>()">
                <option value="">All Payment Status</option>
            </select>
        </div>
        <div class="col-md-3">
            <button class="btn btn-primary w-100">Filter</button>
        </div>
    </div>
</form>

<!-- Table -->
<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order Id</th>
                    <th>User</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th>Total</th>
                    <th>Items</th>
                    <th>Created</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No orders found.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.UserName</td>
                            <td>@await Html.PartialAsync("_OrderStatusBadge", item.OrderStatus)</td>
                            <td>@await Html.PartialAsync("_OrderPaymentBadge", item.PaymentStatus)</td>
                            <td>@item.TotalPrice.ToString("N0")</td>
                            <td>@item.ItemsCount</td>
                            <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_Pagination", Model)