@model SuperMarket.Web.Areas.Admin.ViewModels.Products.ProductDetailsViewModel
@{
    ViewData["Title"] = "Product Details";
}

<partial name="_Alerts" />

<div class="card shadow-sm">
    <div class="card-body">
        <h3 class="fw-bold">@Model.Title</h3>

        <img src="@Model.ImageUrl"
             class="img-fluid mb-3"
             style="max-height:250px;object-fit:cover;" />

        <p><strong>Price:</strong> @Model.Price.ToString("C")</p>
        <p><strong>Stock:</strong> @Model.Stock</p>
        <p><strong>Category:</strong> @Model.CategoryName</p>
        <p>
            <strong>Status:</strong>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                @(Model.IsActive ? "Active" : "Inactive")
            </span>
        </p>
        <p><strong>Created:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
        @if (Model.UpdatedAt.HasValue)
        {
            <p><strong>Updated:</strong> @Model.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</p>
        }
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning mt-3">Edit</a>
<a asp-action="Index" class="btn btn-secondary mt-3">Back</a>