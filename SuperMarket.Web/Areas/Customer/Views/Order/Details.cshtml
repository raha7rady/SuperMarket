@model SuperMarket.Application.DTOs.Orders.OrderCustomerDto

@{
    ViewData["Title"] = "جزئیات سفارش";
    var payments = ViewBag.Payments as SuperMarket.Application.Common.PagedResult<SuperMarket.Application.DTOs.Payments.PaymentCustomerDto>;
}

<div class="container py-4">

    <h2 class="fw-bold mb-4">جزئیات سفارش</h2>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between">
                    <span>کد سفارش: @Model.Id.ToString().Substring(0, 8)</span>
                    <span>@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>محصول</th>
                                <th>قیمت</th>
                                <th>تعداد</th>
                                <th>جمع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductTitle</td>
                                    <td>@item.Price.ToString("N0") تومان</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.SubTotal.ToString("N0") تومان</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span>وضعیت سفارش</span>
                        <span class="badge bg-secondary">@Model.OrderStatus</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>وضعیت پرداخت</span>
                        <span class="badge bg-secondary">@Model.PaymentStatus</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <strong>مبلغ کل</strong>
                        <strong>@Model.TotalPrice.ToString("N0") تومان</strong>
                    </div>
                </div>
            </div>

            @if (payments is { IsSuccess: true } && payments.Value.Count > 0)
            {
                <div class="card shadow-sm mt-3">
                    <div class="card-header bg-white">پرداخت‌ها</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var payment in payments.Value)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@payment.PaymentMethod</span>
                                <span class="badge bg-secondary">@payment.Status</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            <a asp-area="Customer" asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary w-100 mt-3">
                بازگشت به سفارش‌ها
            </a>
        </div>
    </div>

</div>
