@model SuperMarket.Web.Areas.Customer.ViewModels.Products.CustomerProductDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">

    <div class="row g-5">

        <!-- Product Image -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <img src="@(string.IsNullOrWhiteSpace(Model.ImageUrl)
                                ? Url.Content("~/images/no-image.png")
                                : Model.ImageUrl)"
                     alt="@Model.Title"
                     class="img-fluid w-100"
                     loading="lazy"
                     style="height:450px;object-fit:cover;" />

            </div>

        </div>

        <!-- Product Information -->
        <div class="col-lg-7">

            <div class="mb-2">

                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    @Model.CategoryName
                </span>

            </div>

            <h1 class="fw-bold mb-3">
                @Model.Title
            </h1>

            <div class="mb-3">

                <span class="badge @(Model.IsInStock
                                        ? "bg-success"
                                        : "bg-danger")">

                    @Model.StockStatusText

                </span>

            </div>

            <hr />

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-muted lh-lg">
                    @Model.Description
                </p>
            }
            else
            {
                <p class="text-muted">
                    توضیحاتی برای این محصول ثبت نشده است.
                </p>
            }

            <hr />

            @if (Model.ShowOldPrice)
            {
                <div class="mb-4">

                    <span class="fs-2 fw-bold text-danger">

                        @Model.PriceText تومان

                    </span>

                    <del class="text-muted ms-3">

                        @Model.OldPriceText تومان

                    </del>

                    <span class="badge bg-danger ms-2">

                        %@Model.DiscountPercent

                    </span>

                </div>
            }
            else
            {
                <div class="fs-2 fw-bold text-success mb-4">

                    @Model.PriceText تومان

                </div>
            }

            @if (Model.IsInStock)
            {
                <form asp-area="Customer"
                      asp-controller="Cart"
                      asp-action="Add"
                      method="post"
                      id="addToCartForm">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           name="ProductId"
                           value="@Model.Id" />

                    <div class="row g-3 align-items-end">

                        <div class="col-md-3">

                            <label class="form-label fw-semibold">

                                تعداد

                            </label>

                            <input type="number"
                                   name="Quantity"
                                   value="1"
                                   min="1"
                                   max="100"
                                   class="form-control" />

                        </div>

                        <div class="col-md-auto">

                            <button type="submit"
                                    id="btnAddToCart"
                                    class="btn btn-dark px-4">

                                <i class="bi bi-cart-plus me-1"></i>

                                افزودن به سبد خرید

                            </button>

                        </div>

                        <div class="col-md-auto">

                            <a asp-area="Customer"
                               asp-controller="Cart"
                               asp-action="Index"
                               class="btn btn-outline-primary">

                                <i class="bi bi-cart me-1"></i>

                                مشاهده سبد خرید

                            </a>

                        </div>

                    </div>

                </form>
            }
            else
            {
                <button class="btn btn-secondary"
                        disabled>

                    <i class="bi bi-x-circle me-1"></i>

                    ناموجود

                </button>
            }

            <div class="mt-4">

                <a asp-area="Customer"
                   asp-controller="Product"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-right me-1"></i>

                    بازگشت به محصولات

                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document
            .getElementById('addToCartForm')
            ?.addEventListener('submit', function () {

                const button =
                    document.getElementById('btnAddToCart');

                button.disabled = true;

                button.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>در حال افزودن...';
            });

    </script>
}