@model SuperMarket.Web.Areas.Customer.ViewModels.Cart.CartItemViewModel

<tr>

    <td>
        <div class="d-flex align-items-center gap-2">

            <img src="@(string.IsNullOrEmpty(Model.ProductImageUrl)
                        ? "/images/no-image.png"
                        : Model.ProductImageUrl)"
                 alt="@Model.ProductTitle"
                 class="cart-image" />

            <div>
                <strong>@Model.ProductTitle</strong>
            </div>

        </div>
    </td>

    <td>
        @Model.UnitPrice.ToString("N0") تومان
    </td>

    <td>

        <form asp-area="Customer"
              asp-controller="Cart"
              asp-action="Update"
              method="post"
              class="d-flex gap-2 align-items-center">

            @Html.AntiForgeryToken()

            <input type="hidden" name="ProductId" value="@Model.ProductId" />

            <input type="number"
                   name="Quantity"
                   value="@Model.Quantity"
                   min="1"
                   class="form-control form-control-sm"
                   style="width:80px;" />

            <button type="submit"
                    class="btn btn-sm btn-outline-primary">
                بروزرسانی
            </button>

        </form>

    </td>

    <td>
        <strong>@Model.SubTotal.ToString("N0") تومان</strong>
    </td>

    <td>

        <form asp-area="Customer"
              asp-controller="Cart"
              asp-action="Remove"
              asp-route-productId="@Model.ProductId"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-sm btn-outline-danger"
                    onclick="return confirm('حذف این محصول؟');">

                حذف

            </button>

        </form>

    </td>

</tr>